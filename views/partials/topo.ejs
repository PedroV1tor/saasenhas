<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · SaaSenhas</title>
  <link rel="stylesheet" href="/css/estilo.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <header class="topo">
    <a class="marca" href="/"><span class="marca-icone" aria-hidden="true">●</span> SaaSenhas</a>
    <nav class="menu">
    <% if (locals.usuario) { %>
      <a href="/cofre">Cofre</a>
      <a href="/gerador">Gerador</a>
      <span class="quem"><%= usuario %></span>
      <form method="post" action="/sair"><button class="botao botao-pequeno botao-secundario" type="submit">Sair</button></form>
    <% } else { %>
      <a href="/gerador">Gerador</a>
      <a href="/entrar">Entrar</a>
      <a class="botao botao-pequeno" href="/cadastro">Criar conta</a>
    <% } %>
    </nav>
  </header>
  <main class="conteudo">
